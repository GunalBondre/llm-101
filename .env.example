# ─────────────────────────────────────────────
# Copy this file to .env and fill in your keys
# NEVER commit .env to git!
# ─────────────────────────────────────────────

# ── OpenAI (Required for Module 0, 1, 2) ───
OPENAI_API_KEY=sk-...your-key-here...

# ── Anthropic (Optional, Module 2+) ────────
ANTHROPIC_API_KEY=

# ── Google Gemini (Optional, Module 2+) ────
GOOGLE_API_KEY=

# ── LangSmith Tracing (Module 6) ───────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=llm-101

# ── Pinecone (Optional, Module 3) ──────────
PINECONE_API_KEY=
